PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=furnalations
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_ORIGIN=http://localhost:5500
